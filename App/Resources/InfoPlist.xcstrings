    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "FindHub Android używa Bluetooth do namierzania i powiadamiania o utracie kontaktu z Twoimi tagami."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FindHub Android uses Bluetooth to find your trackers nearby and alert you when you lose contact with them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FindHub Android verwendet Bluetooth, um deine Tracker in der Nähe zu finden und dich bei Verbindungsverlust zu benachrichtigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FindHub Android utilise le Bluetooth pour localiser vos traceurs à proximité et vous alerter en cas de perte de contact."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FindHub Android usa Bluetooth para encontrar tus localizadores cercanos y avisarte si pierdes el contacto con ellos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "FindHub Android usa il Bluetooth per trovare i tuoi localizzatori nelle vicinanze e avvisarti se perdi il contatto."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "FindHub Android pokazuje Twoją pozycję i pozwala zaznaczyć obszar domu lub pracy."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FindHub Android shows your position on the map and lets you mark areas such as home or work."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FindHub Android zeigt deine Position auf der Karte und lässt dich Bereiche wie Zuhause oder Arbeit markieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FindHub Android affiche votre position sur la carte et vous permet de délimiter des zones comme la maison ou le travail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FindHub Android muestra tu posición en el mapa y te permite marcar zonas como casa o el trabajo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "FindHub Android mostra la tua posizione sulla mappa e ti permette di segnare aree come casa o lavoro."
          }
        }
      }
    }
  },
  "version": "1.0"
