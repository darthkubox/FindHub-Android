    "Najpierw potrzebny jest nowy odczyt wewnątrz miejsca. Alert wyślę po dwóch kolejnych odczytach wyraźnie poza obszarem.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new reading inside the place is needed first. You’ll be alerted after two consecutive readings clearly outside the area."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst ist ein neuer Messwert innerhalb des Orts nötig. Du wirst nach zwei aufeinanderfolgenden Messwerten eindeutig außerhalb des Bereichs benachrichtigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nouveau relevé à l’intérieur du lieu est d’abord nécessaire. Vous serez alerté après deux relevés consécutifs nettement hors de la zone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero se necesita una lectura nueva dentro del lugar. Recibirás un aviso tras dos lecturas consecutivas claramente fuera de la zona."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve prima una nuova rilevazione all’interno del luogo. Riceverai un avviso dopo due rilevazioni consecutive chiaramente fuori dall’area."
          }
        }
      }
    },
