    "Nie odebrano jeszcze pozycji tego urządzenia.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No location has been received for this device yet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses Gerät wurde noch keine Position empfangen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune position n’a encore été reçue pour cet appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no se ha recibido la ubicación de este dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è ancora stata ricevuta la posizione di questo dispositivo."
          }
        }
      }
    },
    "Nie udało się odczytać klucza lokalizacji tego urządzenia.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device’s location key could not be read."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standortschlüssel dieses Geräts konnte nicht gelesen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire la clé de localisation de cet appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la clave de ubicación de este dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere la chiave di posizione di questo dispositivo."
          }
        }
      }
    },
    "Nie udało się odczytać payloadu raportu": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The report payload could not be read"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Berichtsdaten konnten nicht gelesen werden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire le contenu du rapport"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el contenido del informe"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere il contenuto del rapporto"
          }
        }
      }
    },
    "Nie udało się odczytać zapisanych notatek i historii. Dane nie zostały nadpisane.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved notes and history could not be read. The data was not overwritten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Notizen und Verlauf konnten nicht gelesen werden. Die Daten wurden nicht überschrieben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire les notes et l’historique enregistrés. Les données n’ont pas été écrasées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer las notas y el historial guardados. Los datos no se han sobrescrito."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere note e cronologia salvate. I dati non sono stati sovrascritti."
          }
        }
      }
    },
    "Nie udało się odszyfrować raportów sieciowych": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network reports could not be decrypted"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Netzwerkberichte konnten nicht entschlüsselt werden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de déchiffrer les rapports du réseau"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron descifrar los informes de la red"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile decrittografare i rapporti di rete"
          }
        }
      }
    },
    "Nie udało się połączyć. Ten tag może nie obsługiwać pilnowania w tle.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t connect. This tracker may not support background monitoring."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung fehlgeschlagen. Dieser Tracker unterstützt die Überwachung im Hintergrund möglicherweise nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion impossible. Ce traceur ne prend peut-être pas en charge la surveillance en arrière-plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar. Puede que este localizador no admita la vigilancia en segundo plano."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connessione non riuscita. Questo localizzatore potrebbe non supportare il monitoraggio in background."
          }
        }
      }
    },
    "Nie udało się ustalić Twojej pozycji. Spróbuj ponownie.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t determine your location. Try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Position konnte nicht ermittelt werden. Versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de déterminer votre position. Réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo determinar tu ubicación. Inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile determinare la tua posizione. Riprova."
          }
        }
      }
    },
    "Nie udało się usunąć danych konta z telefonu. Spróbuj ponownie.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t remove the account data from this phone. Try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kontodaten konnten nicht vom Telefon entfernt werden. Versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de supprimer les données du compte de ce téléphone. Réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron eliminar los datos de la cuenta del teléfono. Inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile rimuovere i dati dell’account dal telefono. Riprova."
          }
        }
      }
    },
    "Nie udało się usunąć danych konta.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t remove the account data."
