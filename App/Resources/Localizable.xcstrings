    "Aplikację rozpowszechniamy na licencji GNU GPL v3.0 lub nowszej. Korzysta z pracy autorów GoogleFindMyTools, firebase-messaging, gpsoauth, http_ece, micro-ecc, Chromium i SwiftProtobuf.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app is distributed under the GNU GPL v3.0 or later. It builds on the work of the authors of GoogleFindMyTools, firebase-messaging, gpsoauth, http_ece, micro-ecc, Chromium and SwiftProtobuf."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App wird unter der GNU GPL v3.0 oder neuer verbreitet. Sie baut auf der Arbeit der Autoren von GoogleFindMyTools, firebase-messaging, gpsoauth, http_ece, micro-ecc, Chromium und SwiftProtobuf auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app est distribuée sous licence GNU GPL v3.0 ou ultérieure. Elle s’appuie sur le travail des auteurs de GoogleFindMyTools, firebase-messaging, gpsoauth, http_ece, micro-ecc, Chromium et SwiftProtobuf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app se distribuye bajo la licencia GNU GPL v3.0 o posterior. Se basa en el trabajo de los autores de GoogleFindMyTools, firebase-messaging, gpsoauth, http_ece, micro-ecc, Chromium y SwiftProtobuf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa app è distribuita con licenza GNU GPL v3.0 o successiva. Si basa sul lavoro degli autori di GoogleFindMyTools, firebase-messaging, gpsoauth, http_ece, micro-ecc, Chromium e SwiftProtobuf."
          }
        }
      }
    },
