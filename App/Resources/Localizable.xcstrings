    "Zaznacz obszar domu, pracy lub innego miejsca, a potem przypisz do niego urządzenia — dostaniesz alert, gdy je opuszczą.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark an area for home, work or another place, then assign devices to it — you’ll be alerted when they leave."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiere einen Bereich für Zuhause, Arbeit oder einen anderen Ort und weise ihm Geräte zu – du wirst benachrichtigt, wenn sie ihn verlassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Délimitez une zone pour la maison, le travail ou un autre lieu, puis associez-y des appareils : vous serez alerté quand ils la quittent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca una zona para casa, el trabajo u otro lugar y asígnale dispositivos: recibirás un aviso cuando salgan de ella."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segna un’area per casa, lavoro o un altro luogo e assegnale dei dispositivi: riceverai un avviso quando la lasciano."
          }
        }
      }
    },
    "Zaznacz obszar domu, pracy lub innego miejsca. Urządzenia przypiszesz w ich ustawieniach pilnowania.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark an area for home, work or another place. Assign devices in their monitoring settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiere einen Bereich für Zuhause, Arbeit oder einen anderen Ort. Geräte weist du in ihren Überwachungseinstellungen zu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Délimitez une zone pour la maison, le travail ou un autre lieu. Associez les appareils dans leurs réglages de surveillance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca una zona para casa, el trabajo u otro lugar. Asigna los dispositivos en sus ajustes de vigilancia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segna un’area per casa, lavoro o un altro luogo. Assegna i dispositivi nelle loro impostazioni di monitoraggio."
          }
        }
      }
    },
