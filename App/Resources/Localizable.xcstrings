          }
        }
      }
    },
    "Nie udało się wysłać powiadomienia o opuszczeniu miejsca.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t send the place exit notification."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Benachrichtigung über das Verlassen des Orts konnte nicht gesendet werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’envoyer la notification de sortie du lieu."
          }
        },
        "es": {
