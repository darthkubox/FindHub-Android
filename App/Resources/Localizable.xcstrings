    "Konto %@ zostanie wylogowane z tego iPhone’a. Historia, notatki i miejsca zostaną zachowane.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will be signed out on this iPhone. History, notes and places will be kept."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird auf diesem iPhone abgemeldet. Verlauf, Notizen und Orte bleiben erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sera déconnecté de cet iPhone. L’historique, les notes et les lieux seront conservés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cerrará la sesión de %@ en este iPhone. El historial, las notas y los lugares se conservarán."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’account %@ verrà disconnesso da questo iPhone. Cronologia, note e luoghi verranno conservati."
          }
        }
      }
    },
