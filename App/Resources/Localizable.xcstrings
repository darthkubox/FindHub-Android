    "Wskaźnik rośnie i się ociepla, gdy jesteś bliżej. Idź w stronę, w której sygnał jest najsilniejszy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The indicator grows and warms up as you get closer. Walk in the direction where the signal is strongest."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anzeige wird größer und wärmer, je näher du kommst. Geh in die Richtung mit dem stärksten Signal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’indicateur grossit et se réchauffe à mesure que vous approchez. Avancez vers le signal le plus fort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El indicador crece y se vuelve más cálido al acercarte. Camina hacia donde la señal sea más fuerte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’indicatore cresce e si scalda man mano che ti avvicini. Cammina nella direzione in cui il segnale è più forte."
          }
        }
      }
    },
