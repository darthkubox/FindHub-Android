    "Historia powstaje z odebranych lokalizacji. Otwórz aplikację lub odśwież pozycję, aby zapisać kolejne odczyty.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History is built from received locations. Open the app or refresh the location to record more readings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlauf entsteht aus empfangenen Positionen. Öffne die App oder aktualisiere die Position, um weitere Messwerte zu speichern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique est constitué des positions reçues. Ouvrez l’app ou actualisez la position pour enregistrer d’autres relevés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial se crea con las ubicaciones recibidas. Abre la app o actualiza la ubicación para guardar más lecturas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia si crea dalle posizioni ricevute. Apri l’app o aggiorna la posizione per salvare altre rilevazioni."
          }
        }
      }
    },
