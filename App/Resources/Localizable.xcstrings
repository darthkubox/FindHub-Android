    "Odebrano raport, ale nie udało się potwierdzić jego odszyfrowania. Spróbuj pobrać świeżą pozycję.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A report was received, but its decryption couldn’t be verified. Try fetching a fresh location."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Bericht wurde empfangen, aber seine Entschlüsselung konnte nicht bestätigt werden. Rufe eine aktuelle Position ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rapport a été reçu, mais son déchiffrement n’a pas pu être vérifié. Essayez d’obtenir une position récente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se recibió un informe, pero no se pudo verificar su descifrado. Intenta obtener una ubicación nueva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È arrivato un rapporto, ma non è stato possibile verificarne la decrittografia. Prova a ottenere una posizione aggiornata."
          }
        }
      }
    },
