    "Przypisane urządzenia przestaną być pilnowane w tym obszarze. Historia i notatki zostają.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assigned devices will no longer be monitored in this area. History and notes are kept."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugewiesene Geräte werden in diesem Bereich nicht mehr überwacht. Verlauf und Notizen bleiben erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appareils associés ne seront plus surveillés dans cette zone. L’historique et les notes sont conservés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dispositivos asignados dejarán de vigilarse en esta zona. El historial y las notas se conservan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dispositivi assegnati non saranno più monitorati in quest’area. Cronologia e note restano."
          }
        }
      }
    },
