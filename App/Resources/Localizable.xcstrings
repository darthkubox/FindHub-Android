    "Aby dalej korzystać z aplikacji, zapoznaj się z warunkami korzystania i polityką prywatności.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To keep using the app, please review the terms of use and privacy policy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um die App weiter zu nutzen, lies bitte die Nutzungsbedingungen und die Datenschutzerklärung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour continuer à utiliser l’app, consultez les conditions d’utilisation et la politique de confidentialité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para seguir usando la app, revisa las condiciones de uso y la política de privacidad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per continuare a usare l’app, leggi i termini di utilizzo e l’informativa sulla privacy."
          }
        }
      }
    },
    "Aby dostawać alerty, włącz powiadomienia.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on notifications to receive alerts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Mitteilungen, um Warnungen zu erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez les notifications pour recevoir les alertes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las notificaciones para recibir avisos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva le notifiche per ricevere gli avvisi."
          }
        }
      }
    },
